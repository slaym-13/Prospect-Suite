# Copy to .env and fill in what you have. Everything is optional except SESSION_SECRET in production.
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=change-me-to-a-long-random-string

# SMTP_MODE=json   # dry-run: log messages instead of delivering them

# AI (email drafts + the help assistant) is per person: each user pastes their own
# Google Gemini key on the Settings page. Nothing to set here; this only changes
# which model those keys are used with.
# GEMINI_MODEL=gemini-2.5-flash

# Google Places API (New): fills missing websites/phones. It does NOT return emails.
GOOGLE_PLACES_API_KEY=
