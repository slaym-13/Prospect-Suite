{
  "name": "prospect-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Prospect dashboard (React + Vite client, Express API): lead scoring, AI drafts and email outreach",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "preview": "npm run build && node server.js",
    "create-user": "node scripts/create-user.js",
    "test": "node --test --test-force-exit tests/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "vite": "^7.3.7"
  }
}
